generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum ChargeHeadType {
  MAINTENANCE
  WATER
  SINKING_FUND
  PARKING
  CLUBHOUSE
  PENALTY
  SPECIAL_ASSESSMENT
  OTHER
}

enum VisitorType {
  GUEST
  DELIVERY
  CAB
  SERVICE
  STAFF
  EMERGENCY
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  ENTERED
  EXITED
  EXPIRED
}

enum ApprovalMode {
  PRE_APPROVED
  CALL_APPROVED
  OTP_APPROVED
  QR_APPROVED
  MANUAL
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  SECURITY
  NOISE
  PARKING
  HOUSEKEEPING
  LIFT
  WATER
  LEAKAGE
  STAFF
  OTHER
}

enum MeetingType {
  AGM
  SGM
  COMMITTEE
  EMERGENCY
  TOWER
  GENERAL
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum VoteOption {
  YES
  NO
  ABSTAIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PROXY
}

enum ResolutionType {
  FINANCIAL
  ELECTION
  BYLAW
  MAINTENANCE
  SECURITY
  EMERGENCY
  OTHER
}

enum VotingMethod {
  SIMPLE_MAJORITY
  TWO_THIRDS
  UNANIMOUS
}

enum ResolutionStatus {
  PENDING
  PASSED
  REJECTED
}

model Society {
  id String @id @default(uuid())

  name String

  slug String @unique

  address String?

  city String

  state String

  pincode String?

  status String @default("PENDING_SETUP")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  towers Tower[]

  flats Flat[]

  residentFlats ResidentFlat[]

  chargeHeads ChargeHead[]

  bills Bill[]

  payments Payment[]

  complaints Complaint[]

  meetings Meeting[]

  votes MeetingVote[]

  visitors Visitor[]

  preApprovals VisitorPreApproval[]

  documentRequests DocumentRequest[]

  amenities Amenity[]

  amenityBookings AmenityBooking[]

  parkingSlots ParkingSlot[]

  parkingViolations ParkingViolation[]

  vendors Vendor[]

  staffAttendances StaffAttendance[]

  onboarding         SocietyOnboarding?
  meetingAttendances MeetingAttendance[]
  meetingResolutions MeetingResolution[]

  @@index([city])
  @@index([state])
  @@index([status])
  @@map("societies")
}

model SocietyOnboarding {
  id String @id @default(uuid())

  societyId String @unique

  profileCompleted         Boolean @default(false)
  chairmanCreated          Boolean @default(false)
  towersConfigured         Boolean @default(false)
  flatsImported            Boolean @default(false)
  maintenanceConfigured    Boolean @default(false)
  paymentGatewayConfigured Boolean @default(false)

  completedPercentage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@map("society_onboarding")
}

model Tower {
  id String @id @default(uuid())

  societyId String

  name        String
  totalFloors Int
  totalFlats  Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  flats Flat[]

  @@unique([societyId, name])
  @@index([societyId])
  @@map("towers")
}

model User {
  id String @id @default(uuid())

  phone String @unique

  name String

  email String? @unique

  password String?

  isOnboardingDone Boolean @default(false)

  role String

  gender String?

  dateOfBirth DateTime?

  profileImageUrl String?

  isActive Boolean @default(true)

  isVerified Boolean @default(false)

  joinedAt DateTime @default(now())

  societyId String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  residentFlats ResidentFlat[]

  bills Bill[]

  payments Payment[]

  complaints Complaint[]

  assignedComplaints Complaint[] @relation("ComplaintAssignedTo")

  complaintComments ComplaintComment[]

  complaintActivities ComplaintActivity[]

  meetings Meeting[]

  votes MeetingVote[]

  visitorPreApprovals VisitorPreApproval[]

  visitorEntries Visitor[] @relation("VisitorResident")

  approvedVisitors Visitor[] @relation("VisitorApprovedBy")

  visitors Visitor[]

  documentRequests DocumentRequest[]

  approvedDocuments DocumentRequest[] @relation("DocumentApprovedBy")

  amenityBookings AmenityBooking[]

  parkingSlots ParkingSlot[]

  parkingViolations  ParkingViolation[]
  createdMeetings    Meeting[]           @relation("MeetingCreatedBy")
  meetingAttendances MeetingAttendance[]

  recordedAttendances StaffAttendance[] @relation("AttendanceRecordedBy")

  @@index([societyId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Flat {
  id String @id @default(uuid())

  societyId String

  towerId String

  flatNumber String

  floor Int

  type String?

  areaSqFt Float?

  occupancyStatus String @default("VACANT")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  tower Tower @relation(fields: [towerId], references: [id], onDelete: Cascade)

  residentFlats ResidentFlat[]

  bills Bill[]

  payments Payment[]

  complaints Complaint[]

  visitors Visitor[]

  parkingSlots ParkingSlot[]

  documentRequests    DocumentRequest[]
  visitorPreApprovals VisitorPreApproval[]
  meetingVotes        MeetingVote[]
  meetingAttendances  MeetingAttendance[]

  @@unique([towerId, flatNumber])
  @@index([societyId])
  @@index([towerId])
  @@map("flats")
}

model ResidentFlat {
  id String @id @default(uuid())

  userId String

  flatId String

  societyId String

  relationType String
  /**
   * OWNER
   * TENANT
   * FAMILY_MEMBER
   * ASSOCIATE
   */

  isPrimary Boolean @default(false)

  moveInDate DateTime @default(now())

  moveOutDate DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flatId])
  @@index([societyId])
  @@map("resident_flats")
}

model ChargeHead {
  id String @id @default(uuid())

  societyId String

  name String

  code String

  type ChargeHeadType

  description String?

  defaultAmount Decimal @db.Decimal(10, 2)

  isRecurring Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  billLineItems BillLineItem[]

  @@unique([societyId, code])
  @@index([societyId, isActive])
  @@map("charge_heads")
}

model Complaint {
  id String @id @default(uuid())

  societyId String

  userId String

  flatId String?

  assignedToId String?

  vendorId String?

  title String

  description String

  category ComplaintCategory

  priority ComplaintPriority @default(MEDIUM)

  status ComplaintStatus @default(OPEN)

  ticketNumber String @unique

  isAnonymous Boolean @default(false)

  attachmentUrls String[]

  resolutionNotes String?

  residentFeedback String?

  residentRating Int?

  estimatedResolutionAt DateTime?

  assignedAt DateTime?

  acknowledgedAt DateTime?

  inProgressAt DateTime?

  resolvedAt DateTime?

  closedAt DateTime?

  reopenedAt DateTime?

  escalatedAt DateTime?

  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id], onDelete: SetNull)

  assignedTo User? @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  comments ComplaintComment[]

  activities ComplaintActivity[]

  @@index([societyId, status])
  @@index([societyId, priority])
  @@index([societyId, category])
  @@index([assignedToId])
  @@index([vendorId])
  @@index([ticketNumber])
  @@map("complaints")
}

model ComplaintComment {
  id String @id @default(uuid())

  complaintId String

  userId String

  comment String

  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_comments")
}

model ComplaintActivity {
  id String @id @default(uuid())

  complaintId String

  userId String?

  action String

  oldValue String?

  newValue String?

  remarks String?

  createdAt DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@map("complaint_activities")
}

model Meeting {
  id String @id @default(uuid())

  societyId   String
  createdById String

  title       String
  description String?

  meetingType MeetingType

  status MeetingStatus @default(SCHEDULED)

  agenda Json?

  meetingNotes String?

  minutesDocumentUrl String?

  location String?

  meetingLink String?

  scheduledAt DateTime

  startedAt DateTime?

  endedAt DateTime?

  votingStartsAt DateTime?

  votingEndsAt DateTime?

  quorumPercentage Int @default(51)

  totalEligibleVoters Int @default(0)

  totalVotesCast Int @default(0)

  isVotingEnabled Boolean @default(false)

  isAnonymousVoting Boolean @default(false)

  allowProxyVotes Boolean @default(false)

  attachmentUrls Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  createdBy User @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  votes MeetingVote[]

  attendances MeetingAttendance[]

  resolutions MeetingResolution[]
  user        User?               @relation(fields: [userId], references: [id])
  userId      String?

  @@index([societyId, scheduledAt])
  @@index([societyId, status])
  @@map("meetings")
}

model MeetingVote {
  id String @id @default(uuid())

  societyId String

  meetingId String

  userId String

  flatId String?

  resolutionId String?

  vote VoteOption

  votingWeight Decimal @default(1)

  remarks String?

  isProxyVote Boolean @default(false)

  proxyHolderName String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id])

  resolution MeetingResolution? @relation(fields: [resolutionId], references: [id])

  @@unique([meetingId, userId, resolutionId])
  @@index([societyId, meetingId])
  @@index([resolutionId])
  @@map("meeting_votes")
}

model MeetingAttendance {
  id String @id @default(uuid())

  societyId String

  meetingId String

  userId String

  flatId String?

  attendanceStatus AttendanceStatus

  checkInAt DateTime?

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id])

  @@unique([meetingId, userId])
  @@index([societyId, meetingId])
  @@map("meeting_attendances")
}

model MeetingResolution {
  id String @id @default(uuid())

  societyId String

  meetingId String

  title String

  description String?

  resolutionType ResolutionType

  votingMethod VotingMethod @default(SIMPLE_MAJORITY)

  status ResolutionStatus @default(PENDING)

  passedAt DateTime?

  rejectedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  votes MeetingVote[]

  @@index([societyId, meetingId])
  @@map("meeting_resolutions")
}

model Visitor {
  id String @id @default(uuid())

  societyId String

  flatId String?

  residentId String?

  approvedById String?

  preApprovalId String?

  name String

  phone String?

  visitorType VisitorType

  purpose String?

  vehicleNo String?

  companyName String?

  photoUrl String?

  entryGate String?

  exitGate String?

  approvalMode ApprovalMode?

  status VisitorStatus @default(PENDING)

  isInside Boolean @default(false)

  entryAt DateTime?

  exitAt DateTime?

  approvedAt DateTime?

  deniedAt DateTime?

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id])

  resident User? @relation("VisitorResident", fields: [residentId], references: [id])

  approvedBy User? @relation("VisitorApprovedBy", fields: [approvedById], references: [id])

  preApproval VisitorPreApproval? @relation(fields: [preApprovalId], references: [id])
  user        User?               @relation(fields: [userId], references: [id])
  userId      String?

  @@index([societyId, status])
  @@index([societyId, visitorType])
  @@index([societyId, entryAt])
  @@map("visitors")
}

model VisitorPreApproval {
  id String @id @default(uuid())

  societyId String

  userId String

  flatId String?

  visitorName String

  visitorPhone String?

  visitorType VisitorType

  purpose String?

  vehicleNo String?

  qrCode String?

  maxEntries Int @default(1)

  usedEntries Int @default(0)

  validFrom DateTime @default(now())

  validUntil DateTime

  status VisitorStatus @default(APPROVED)

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id])

  visitors Visitor[]

  @@index([societyId, status])
  @@index([societyId, validUntil])
  @@map("visitor_pre_approvals")
}

model DocumentRequest {
  id String @id @default(uuid())

  societyId String
  userId    String

  approvedById String?

  documentType String

  reason String?

  status String @default("PENDING")

  fileUrl String?

  requestedAt DateTime @default(now())

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvedBy User?   @relation("DocumentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  flat       Flat?   @relation(fields: [flatId], references: [id])
  flatId     String?

  @@index([societyId, status])
  @@map("document_requests")
}

model Amenity {
  id String @id @default(uuid())

  societyId String

  name String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  bookings AmenityBooking[]

  @@index([societyId, isActive])
  @@map("amenities")
}

model AmenityBooking {
  id String @id @default(uuid())

  societyId String
  amenityId String
  userId    String

  startsAt DateTime
  endsAt   DateTime

  status String @default("CONFIRMED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([societyId, amenityId, startsAt])
  @@map("amenity_bookings")
}

model ParkingSlot {
  id String @id @default(uuid())

  societyId String

  flatId String?

  userId String?

  slotNumber String

  level String?

  vehicleType String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id], onDelete: SetNull)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([societyId, slotNumber])
  @@index([societyId, flatId])
  @@map("parking_slots")
}

model ParkingViolation {
  id String @id @default(uuid())

  societyId String

  reportedById String

  slotNumber String?

  vehicleNo String?

  description String

  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  reportedBy User @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([societyId, status])
  @@map("parking_violations")
}

model Vendor {
  id String @id @default(uuid())

  societyId String

  name String

  category String

  phone String?

  email String?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  complaints Complaint[]

  @@index([societyId, category])
  @@map("vendors")
}

model StaffAttendance {
  id String @id @default(uuid())

  societyId String

  staffName String

  role String

  status String

  checkInAt DateTime @default(now())

  checkOutAt DateTime?

  recordedById String

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  recordedBy User @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([societyId, checkInAt])
  @@map("staff_attendances")
}

model Bill {
  id String @id @default(uuid())

  societyId String

  userId String

  flatId String

  billNumber String @unique

  period String

  subtotal Decimal @db.Decimal(10, 2)

  penaltyAmount Decimal @default(0) @db.Decimal(10, 2)

  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  totalAmount Decimal @db.Decimal(10, 2)

  paidAmount Decimal @default(0) @db.Decimal(10, 2)

  dueAmount Decimal @db.Decimal(10, 2)

  dueDate DateTime

  status BillStatus @default(PENDING)

  notes String?

  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)

  lineItems BillLineItem[]

  payments Payment[]

  @@index([societyId, period])
  @@index([societyId, status])
  @@index([billNumber])
  @@map("bills")
}

model BillLineItem {
  id String @id @default(uuid())

  billId String

  chargeHeadId String

  description String?

  quantity Int @default(1)

  unitAmount Decimal @db.Decimal(10, 2)

  totalAmount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  chargeHead ChargeHead @relation(fields: [chargeHeadId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([chargeHeadId])
  @@map("bill_line_items")
}

model Payment {
  id String @id @default(uuid())

  societyId String

  userId String

  flatId String?

  billId String?

  receiptNumber String @unique

  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod

  status PaymentStatus @default(SUCCESS)

  transactionReference String?

  remarks String?

  razorpayOrderId String? @unique

  razorpayPaymentId String? @unique

  paidAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bill Bill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  flat Flat? @relation(fields: [flatId], references: [id])

  @@index([societyId, status])
  @@index([receiptNumber])
  @@map("payments")
}
