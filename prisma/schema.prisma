generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum ChargeHeadType {
  MAINTENANCE
  WATER
  SINKING_FUND
  PARKING
  CLUBHOUSE
  PENALTY
  SPECIAL_ASSESSMENT
  OTHER
}

model Society {
  id String @id @default(uuid())

  name String

  slug String @unique

  address String?

  city String

  state String

  pincode String?

  status String @default("PENDING_SETUP")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  towers Tower[]

  flats Flat[]

  residentFlats ResidentFlat[]

  chargeHeads ChargeHead[]

  bills Bill[]

  payments Payment[]

  complaints Complaint[]

  meetings Meeting[]

  votes MeetingVote[]

  visitors Visitor[]

  preApprovals VisitorPreApproval[]

  documentRequests DocumentRequest[]

  amenities Amenity[]

  amenityBookings AmenityBooking[]

  parkingSlots ParkingSlot[]

  parkingViolations ParkingViolation[]

  vendors Vendor[]

  staffAttendances StaffAttendance[]

  onboarding SocietyOnboarding?

  @@index([city])
  @@index([state])
  @@index([status])
  @@map("societies")
}

model SocietyOnboarding {
  id String @id @default(uuid())

  societyId String @unique

  profileCompleted         Boolean @default(false)
  chairmanCreated          Boolean @default(false)
  towersConfigured         Boolean @default(false)
  flatsImported            Boolean @default(false)
  maintenanceConfigured    Boolean @default(false)
  paymentGatewayConfigured Boolean @default(false)

  completedPercentage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@map("society_onboarding")
}

model Tower {
  id String @id @default(uuid())

  societyId String

  name        String
  totalFloors Int
  totalFlats  Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  flats Flat[]

  @@unique([societyId, name])
  @@index([societyId])
  @@map("towers")
}

model User {
  id String @id @default(uuid())

  phone String @unique

  name String

  email String? @unique

  password String?

  isOnboardingDone Boolean @default(false)

  role String

  gender String?

  dateOfBirth DateTime?

  profileImageUrl String?

  isActive Boolean @default(true)

  isVerified Boolean @default(false)

  joinedAt DateTime @default(now())

  societyId String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  residentFlats ResidentFlat[]

  bills Bill[]

  payments Payment[]

  complaints Complaint[]

  meetings Meeting[]

  votes MeetingVote[]

  visitorPreApprovals VisitorPreApproval[]

  documentRequests DocumentRequest[]

  approvedDocuments DocumentRequest[] @relation("DocumentApprovedBy")

  amenityBookings AmenityBooking[]

  parkingSlots ParkingSlot[]

  parkingViolations ParkingViolation[]

  recordedAttendances StaffAttendance[] @relation("AttendanceRecordedBy")

  @@index([societyId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Flat {
  id String @id @default(uuid())

  societyId String

  towerId String

  flatNumber String

  floor Int

  type String?

  areaSqFt Float?

  occupancyStatus String @default("VACANT")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  tower Tower @relation(fields: [towerId], references: [id], onDelete: Cascade)

  residentFlats ResidentFlat[]

  bills Bill[]

  payments Payment[]

  complaints Complaint[]

  visitors Visitor[]

  parkingSlots ParkingSlot[]

  documentRequests DocumentRequest[]

  @@unique([towerId, flatNumber])
  @@index([societyId])
  @@index([towerId])
  @@map("flats")
}

model ResidentFlat {
  id String @id @default(uuid())

  userId String

  flatId String

  societyId String

  relationType String
  /**
   * OWNER
   * TENANT
   * FAMILY_MEMBER
   * ASSOCIATE
   */

  isPrimary Boolean @default(false)

  moveInDate DateTime @default(now())

  moveOutDate DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flatId])
  @@index([societyId])
  @@map("resident_flats")
}

model ChargeHead {
  id String @id @default(uuid())

  societyId String

  name String

  code String

  type ChargeHeadType

  description String?

  defaultAmount Decimal @db.Decimal(10, 2)

  isRecurring Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  billLineItems BillLineItem[]

  @@unique([societyId, code])
  @@index([societyId, isActive])
  @@map("charge_heads")
}

model Complaint {
  id          String    @id @default(uuid())
  societyId   String
  userId      String
  flatId      String?
  title       String
  description String
  category    String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  isAnonymous Boolean   @default(false)
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id], onDelete: SetNull)

  @@index([societyId, status])
  @@map("complaints")
}

model Meeting {
  id String @id @default(uuid())

  societyId   String
  createdById String

  title  String
  agenda String

  scheduledAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  votes MeetingVote[]

  @@index([societyId, scheduledAt])
  @@map("meetings")
}

model MeetingVote {
  id String @id @default(uuid())

  societyId String
  meetingId String
  userId    String

  vote String

  createdAt DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([societyId, meetingId])
  @@map("meeting_votes")
}

model Visitor {
  id String @id @default(uuid())

  societyId String

  name String

  phone String?

  purpose String?

  vehicleNo String?

  status String @default("ENTERED")

  entryAt DateTime @default(now())

  exitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat?   @relation(fields: [flatId], references: [id])
  flatId  String?

  @@index([societyId, entryAt])
  @@map("visitors")
}

model VisitorPreApproval {
  id String @id @default(uuid())

  societyId String
  userId    String

  visitorName String

  visitorPhone String?

  purpose String?

  validFrom DateTime @default(now())

  validUntil DateTime

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([societyId, status])
  @@map("visitor_pre_approvals")
}

model DocumentRequest {
  id String @id @default(uuid())

  societyId String
  userId    String

  approvedById String?

  documentType String

  reason String?

  status String @default("PENDING")

  fileUrl String?

  requestedAt DateTime @default(now())

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvedBy User?   @relation("DocumentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  flat       Flat?   @relation(fields: [flatId], references: [id])
  flatId     String?

  @@index([societyId, status])
  @@map("document_requests")
}

model Amenity {
  id String @id @default(uuid())

  societyId String

  name String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  bookings AmenityBooking[]

  @@index([societyId, isActive])
  @@map("amenities")
}

model AmenityBooking {
  id String @id @default(uuid())

  societyId String
  amenityId String
  userId    String

  startsAt DateTime
  endsAt   DateTime

  status String @default("CONFIRMED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([societyId, amenityId, startsAt])
  @@map("amenity_bookings")
}

model ParkingSlot {
  id String @id @default(uuid())

  societyId String

  flatId String?

  userId String?

  slotNumber String

  level String?

  vehicleType String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  flat Flat? @relation(fields: [flatId], references: [id], onDelete: SetNull)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([societyId, slotNumber])
  @@index([societyId, flatId])
  @@map("parking_slots")
}

model ParkingViolation {
  id String @id @default(uuid())

  societyId String

  reportedById String

  slotNumber String?

  vehicleNo String?

  description String

  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  reportedBy User @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([societyId, status])
  @@map("parking_violations")
}

model Vendor {
  id String @id @default(uuid())

  societyId String

  name String

  category String

  phone String?

  email String?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, category])
  @@map("vendors")
}

model StaffAttendance {
  id String @id @default(uuid())

  societyId String

  staffName String

  role String

  status String

  checkInAt DateTime @default(now())

  checkOutAt DateTime?

  recordedById String

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  recordedBy User @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([societyId, checkInAt])
  @@map("staff_attendances")
}

model Bill {
  id String @id @default(uuid())

  societyId String

  userId String

  flatId String

  billNumber String @unique

  period String

  subtotal Decimal @db.Decimal(10, 2)

  penaltyAmount Decimal @default(0) @db.Decimal(10, 2)

  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  totalAmount Decimal @db.Decimal(10, 2)

  paidAmount Decimal @default(0) @db.Decimal(10, 2)

  dueAmount Decimal @db.Decimal(10, 2)

  dueDate DateTime

  status BillStatus @default(PENDING)

  notes String?

  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)

  lineItems BillLineItem[]

  payments Payment[]

  @@index([societyId, period])
  @@index([societyId, status])
  @@index([billNumber])
  @@map("bills")
}

model BillLineItem {
  id String @id @default(uuid())

  billId String

  chargeHeadId String

  description String?

  quantity Int @default(1)

  unitAmount Decimal @db.Decimal(10, 2)

  totalAmount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  chargeHead ChargeHead @relation(fields: [chargeHeadId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([chargeHeadId])
  @@map("bill_line_items")
}

model Payment {
  id String @id @default(uuid())

  societyId String

  userId String

  flatId String?

  billId String?

  receiptNumber String @unique

  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod

  status PaymentStatus @default(SUCCESS)

  transactionReference String?

  remarks String?

  razorpayOrderId String? @unique

  razorpayPaymentId String? @unique

  paidAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bill Bill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  flat Flat? @relation(fields: [flatId], references: [id])

  @@index([societyId, status])
  @@index([receiptNumber])
  @@map("payments")
}
