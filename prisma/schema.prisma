generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Society {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  address   String?
  city      String
  state     String
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  flats Flat[]
  bills Bill[]
  payments Payment[]

  @@map("societies")
}

model User {
  id        String  @id @default(uuid())
  phone     String  @unique
  name      String
  email     String? @unique
  password  String?
  role      String
  societyId String
  flatId    String?
  towerId   String?

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flat      Flat?    @relation(fields: [flatId], references: [id])
  bills     Bill[]
  payments  Payment[]

  @@map("users")
}

model Flat {
  id         String @id @default(uuid())
  flatNumber String
  tower      String
  floor      Int
  flatType   String
  societyId  String

  society Society @relation(fields: [societyId], references: [id])
  users   User[]
  bills   Bill[]

  @@unique([societyId, flatNumber, tower])
  @@map("flats")
}

model Bill {
  id          String   @id @default(uuid())
  societyId   String
  userId      String
  flatId      String
  period      String
  amount      Decimal  @db.Decimal(10, 2)
  dueDate     DateTime
  status      String   @default("PENDING")
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society  Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat     Flat      @relation(fields: [flatId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([societyId, period])
  @@map("bills")
}

model Payment {
  id              String   @id @default(uuid())
  societyId       String
  userId          String
  billId          String?
  amount          Decimal  @db.Decimal(10, 2)
  method          String
  status          String   @default("SUCCESS")
  razorpayOrderId String?  @unique
  razorpayPaymentId String? @unique
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill    Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([societyId, status])
  @@map("payments")
}
